BACKUP ~Derats_KriBinn/Backup~
AUTHOR ~Deratiseur, at the_deratiseur@hotmail.com~
VERSION ~8~

README ~Derats_KriBinn/Documents/Readme_%LANGUAGE%.html~

AUTO_TRA ~Derats_KriBinn/Languages/%s~

LANGUAGE ~Francais~	~French~
	~Derats_KriBinn/Languages/French/Setup.tra~

LANGUAGE ~English~	~English~
	~Derats_KriBinn/Languages/English/Setup.tra~

LANGUAGE ~Simplified Chinese~	~SChinese~
	~Derats_KriBinn/Languages/SChinese/Setup.tra~
	
LANGUAGE ~Russian~	~Russian~
	~Derats_KriBinn/Languages/Russian/Setup.tra~	
	
BEGIN @0	DESIGNATED 0
REQUIRE_PREDICATE GAME_IS ~BG2EE EET IWDEE PSTEE~ @0009

// PSTEE uniquement : adapter les sommes affichees dans PXKPSTEE.DLG.
// La routine traite chaque strref une seule fois (plusieurs repliques peuvent le partager).
DEFINE_PATCH_MACRO ~PXK_PSTEE_TARIF_TLK~ BEGIN
  PATCH_IF (prix_ref >= 0) AND (prix_ref < 2147483647) BEGIN
    PATCH_IF (INDEX(~|%prix_ref%|~ ~%prix_deja%~) < 0) BEGIN
      SPRINT prix_deja ~%prix_deja%|%prix_ref%|~
      GET_STRREF prix_ref prix_original
      INNER_PATCH_SAVE prix_nouveau ~%prix_original%~ BEGIN
        REPLACE_TEXTUALLY ~100 000~ ~PXKTARIFAAFIN~
        REPLACE_TEXTUALLY ~100,000~ ~PXKTARIFABFIN~
        REPLACE_TEXTUALLY ~100000~ ~PXKTARIFACFIN~
        REPLACE_TEXTUALLY ~75 000~ ~PXKTARIFBAFIN~
        REPLACE_TEXTUALLY ~75,000~ ~PXKTARIFBBFIN~
        REPLACE_TEXTUALLY ~75000~ ~PXKTARIFBCFIN~
        REPLACE_TEXTUALLY ~65 000~ ~PXKTARIFCAFIN~
        REPLACE_TEXTUALLY ~65,000~ ~PXKTARIFCBFIN~
        REPLACE_TEXTUALLY ~65000~ ~PXKTARIFCCFIN~
        REPLACE_TEXTUALLY ~50 000~ ~PXKTARIFDAFIN~
        REPLACE_TEXTUALLY ~50,000~ ~PXKTARIFDBFIN~
        REPLACE_TEXTUALLY ~50000~ ~PXKTARIFDCFIN~
        REPLACE_TEXTUALLY ~25 000~ ~PXKTARIFEAFIN~
        REPLACE_TEXTUALLY ~25,000~ ~PXKTARIFEBFIN~
        REPLACE_TEXTUALLY ~25000~ ~PXKTARIFECFIN~
        REPLACE_TEXTUALLY ~20 000~ ~PXKTARIFFAFIN~
        REPLACE_TEXTUALLY ~20,000~ ~PXKTARIFFBFIN~
        REPLACE_TEXTUALLY ~20000~ ~PXKTARIFFCFIN~
        REPLACE_TEXTUALLY ~17 500~ ~PXKTARIFGAFIN~
        REPLACE_TEXTUALLY ~17,500~ ~PXKTARIFGBFIN~
        REPLACE_TEXTUALLY ~17500~ ~PXKTARIFGCFIN~
        REPLACE_TEXTUALLY ~15 000~ ~PXKTARIFHAFIN~
        REPLACE_TEXTUALLY ~15,000~ ~PXKTARIFHBFIN~
        REPLACE_TEXTUALLY ~15000~ ~PXKTARIFHCFIN~
        REPLACE_TEXTUALLY ~12 500~ ~PXKTARIFIAFIN~
        REPLACE_TEXTUALLY ~12,500~ ~PXKTARIFIBFIN~
        REPLACE_TEXTUALLY ~12500~ ~PXKTARIFICFIN~
        REPLACE_TEXTUALLY ~10 000~ ~PXKTARIFJAFIN~
        REPLACE_TEXTUALLY ~10,000~ ~PXKTARIFJBFIN~
        REPLACE_TEXTUALLY ~10000~ ~PXKTARIFJCFIN~
        REPLACE_TEXTUALLY ~8 500~ ~PXKTARIFKAFIN~
        REPLACE_TEXTUALLY ~8,500~ ~PXKTARIFKBFIN~
        REPLACE_TEXTUALLY ~8500~ ~PXKTARIFKCFIN~
        REPLACE_TEXTUALLY ~PXKTARIFAAFIN~ ~20 000~
        REPLACE_TEXTUALLY ~PXKTARIFABFIN~ ~20,000~
        REPLACE_TEXTUALLY ~PXKTARIFACFIN~ ~20000~
        REPLACE_TEXTUALLY ~PXKTARIFBAFIN~ ~15 000~
        REPLACE_TEXTUALLY ~PXKTARIFBBFIN~ ~15,000~
        REPLACE_TEXTUALLY ~PXKTARIFBCFIN~ ~15000~
        REPLACE_TEXTUALLY ~PXKTARIFCAFIN~ ~13 000~
        REPLACE_TEXTUALLY ~PXKTARIFCBFIN~ ~13,000~
        REPLACE_TEXTUALLY ~PXKTARIFCCFIN~ ~13000~
        REPLACE_TEXTUALLY ~PXKTARIFDAFIN~ ~10 000~
        REPLACE_TEXTUALLY ~PXKTARIFDBFIN~ ~10,000~
        REPLACE_TEXTUALLY ~PXKTARIFDCFIN~ ~10000~
        REPLACE_TEXTUALLY ~PXKTARIFEAFIN~ ~5 000~
        REPLACE_TEXTUALLY ~PXKTARIFEBFIN~ ~5,000~
        REPLACE_TEXTUALLY ~PXKTARIFECFIN~ ~5000~
        REPLACE_TEXTUALLY ~PXKTARIFFAFIN~ ~4 000~
        REPLACE_TEXTUALLY ~PXKTARIFFBFIN~ ~4,000~
        REPLACE_TEXTUALLY ~PXKTARIFFCFIN~ ~4000~
        REPLACE_TEXTUALLY ~PXKTARIFGAFIN~ ~3 500~
        REPLACE_TEXTUALLY ~PXKTARIFGBFIN~ ~3,500~
        REPLACE_TEXTUALLY ~PXKTARIFGCFIN~ ~3500~
        REPLACE_TEXTUALLY ~PXKTARIFHAFIN~ ~3 000~
        REPLACE_TEXTUALLY ~PXKTARIFHBFIN~ ~3,000~
        REPLACE_TEXTUALLY ~PXKTARIFHCFIN~ ~3000~
        REPLACE_TEXTUALLY ~PXKTARIFIAFIN~ ~2 500~
        REPLACE_TEXTUALLY ~PXKTARIFIBFIN~ ~2,500~
        REPLACE_TEXTUALLY ~PXKTARIFICFIN~ ~2500~
        REPLACE_TEXTUALLY ~PXKTARIFJAFIN~ ~2 000~
        REPLACE_TEXTUALLY ~PXKTARIFJBFIN~ ~2,000~
        REPLACE_TEXTUALLY ~PXKTARIFJCFIN~ ~2000~
        REPLACE_TEXTUALLY ~PXKTARIFKAFIN~ ~1 700~
        REPLACE_TEXTUALLY ~PXKTARIFKBFIN~ ~1,700~
        REPLACE_TEXTUALLY ~PXKTARIFKCFIN~ ~1700~
      END
      PATCH_IF (~%prix_original%~ STRING_COMPARE_CASE ~%prix_nouveau%~) BEGIN
        INNER_ACTION BEGIN
          STRING_SET_EVALUATE prix_ref ~%prix_nouveau%~
        END
      END
    END
  END
END



ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
EXTEND_TOP ~AR0700.BCS~	~Derats_KriBinn/Divers/pxk0700.baf~
EXTEND_TOP ~DPLAYER2.BCS~	~Derats_KriBinn/Divers/Hotkey.baf~
EXTEND_TOP ~DPLAYER3.BCS~	~Derats_KriBinn/Divers/Hotkey.baf~
COPY_EXISTING	~S1-10M4.itm~				~override/pxkroban.itm~	WRITE_BYTE 0x60 1	WRITE_ASCII 0x3a ~~ #8	WRITE_ASCII 0x76 ~~ #8
END
ACTION_IF GAME_IS ~IWDEE~ THEN BEGIN
EXTEND_TOP ~AR2100.BCS~	~Derats_KriBinn/Divers/pxk2100.baf~
EXTEND_TOP ~DPLAYER2.BCS~	~Derats_KriBinn/Divers/Hotkey.baf~
EXTEND_TOP ~DPLAYER3.BCS~	~Derats_KriBinn/Divers/Hotkey.baf~
COPY_EXISTING	~S1-10M2.itm~				~override/pxkroban.itm~	WRITE_BYTE 0x60 1	WRITE_ASCII 0x3a ~~ #8	WRITE_ASCII 0x76 ~~ #8
END

ACTION_IF GAME_IS ~PSTEE~ THEN BEGIN
EXTEND_TOP ~AR0500.BCS~	~Derats_KriBinn/Divers/pxk0500.baf~
EXTEND_TOP ~PCNAME.BCS~	~Derats_KriBinn/Divers/Hotkey.baf~
COPY_EXISTING	~IDAG1D10.itm~				~override/pxkroban.itm~	WRITE_BYTE 0x60 1	WRITE_ASCII 0x3a ~~ #8	WRITE_ASCII 0x76 ~~ #8
COPY ~Derats_KriBinn/Divers/spcl232.spl~				 ~override~	SAY NAME2 @4
END

INCLUDE ~Derats_KriBinn/Divers/Codes.tpa~ 
COMPILE ~Derats_KriBinn/Scripts~
COMPILE ~Derats_KriBinn/D/pxkribin.d~

ACTION_IF GAME_IS ~PSTEE~ THEN BEGIN
	COMPILE ~Derats_KriBinn/D/pxkpstee.d~
		USING
		~Derats_KriBinn/Languages/English/pxkgilbe.tra~
		~Derats_KriBinn/Languages/%LANGUAGE%/pxkgilbe.tra~

  // Adapter les prix du texte (TLK) sans changer les .tra ni les sommes du .d.
  COPY_EXISTING ~pxkpstee.dlg~ ~override~
    READ_LONG 0x08 prix_nb_etats
    READ_LONG 0x0c prix_off_etats
    READ_LONG 0x10 prix_nb_reponses
    READ_LONG 0x14 prix_off_reponses
    SPRINT prix_deja ~|~
    FOR (prix_i = 0; prix_i < prix_nb_etats; prix_i += 1) BEGIN
      READ_LONG (prix_off_etats + prix_i * 0x10) prix_ref
      LAUNCH_PATCH_MACRO ~PXK_PSTEE_TARIF_TLK~
    END
    FOR (prix_i = 0; prix_i < prix_nb_reponses; prix_i += 1) BEGIN
      READ_LONG (prix_off_reponses + prix_i * 0x20) prix_flags
      PATCH_IF ((prix_flags BAND 1) = 1) BEGIN
        READ_LONG (prix_off_reponses + prix_i * 0x20 + 0x04) prix_ref
        LAUNCH_PATCH_MACRO ~PXK_PSTEE_TARIF_TLK~
      END
    END
END ELSE BEGIN
	COMPILE ~Derats_KriBinn/D/pxkgilbe.d~
	 PATCH_IF GAME_IS ~IWDEE~ THEN BEGIN
    REPLACE_TEXTUALLY ~REPLY @552~ ~REPLY @569~
  END
END

ACTION_IF GAME_IS ~BG2EE EET~ THEN BEGIN
	COMPILE ~Derats_KriBinn/D/pxkcomments.d~
		USING
		~Derats_KriBinn/Languages/English/pxkgilbe.tra~
		~Derats_KriBinn/Languages/%LANGUAGE%/pxkgilbe.tra~
END

COPY ~Derats_KriBinn/Copy~					~override~

LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0xE000 slotMax = 0xefff RET slot END
ACTION_IF (slot <= 0) BEGIN
  FAIL ~No free creature animation slot found.~
END
LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
APPEND ~animate.ids~ ~0x%hexNumber% Mechanical_Spider_Green~ UNLESS ~Mechanical_Spider_Green~
CLEAR_IDS_MAP
COPY ~Derats_KriBinn/Divers/pxkr.ini~ ~override/%hexNumber%.ini~
ACTION_BASH_FOR ~Derats_KriBinn/Spider~ ~^.+\.bam$~ BEGIN
  COPY ~%BASH_FOR_FILESPEC%~ ~override~
END
COPY ~Derats_KriBinn/Divers/pxkribin.cre~ ~override~	SAY NAME1 @1	SAY NAME2 @1	WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~Mechanical_Spider_Green~))
COPY ~Derats_KriBinn/Divers/pxkrotan.cre~ ~override~	SAY NAME1 @2	SAY NAME2 @2	WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~Mechanical_Spider_Green~))
COPY ~Derats_KriBinn/Divers/pxkgilbe.cre~ ~override~	SAY NAME1 @3	SAY NAME2 @3

ACTION_IF GAME_IS ~PSTEE~ THEN BEGIN
COPY_EXISTING	~pxkribin.cre~							~override~	
	REPLACE_CRE_ITEM ~IDAG1D8~ #0 #0 #0 ~UNDROPPABLE~ ~WEAPON1~ EQUIP
END

ACTION_IF GAME_IS ~BG2EE EET IWDEE~ THEN BEGIN
	COPY_EXISTING	~sparm2.vvc~			~override/pxkribiv.vvc~	WRITE_ASCII 0x8 ~pxkribi1~ #8
	COPY_EXISTING	~sparm2.vvc~			~override/pxkrib2v.vvc~	WRITE_ASCII 0x8 ~pxkribi2~ #8
	COPY_EXISTING	~pxkribi0.eff~			~override/pxkribi4.eff~	WRITE_ASCII 0x30 ~pxkribi4~ #8
	COPY_EXISTING	~Spwi413A.spl~			~override/pxkribi1.spl~ WRITE_BYTE 0x1c 4
	READ_LONG 0x6a effects_off
	READ_SHORT 0x90 num_effects
	FOR (i = 0; i < num_effects; i += 1) BEGIN			
		WRITE_BYTE (effects_off + 0x30*i + 0x0e) 36
	END
END

ACTION_IF GAME_IS ~PSTEE~ THEN BEGIN
	COPY_EXISTING	~bd188.vvc~				~override/pxkribiv.vvc~	WRITE_ASCII 0x8 ~pxkribi1~ #8	WRITE_BYTE 0x20 (THIS | 1)
	COPY_EXISTING	~pxkribiv.vvc~			~override/pxkrib2v.vvc~	WRITE_ASCII 0x8 ~pxkribi2~ #8
	COPY_EXISTING	~pxkgilbe.cre~						~override~	WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~Merchant~)) WRITE_ASCII 0x2cc ~pxkpstee~ #8
	COPY_EXISTING	~pxkribin.cre~						~override~
					~pxkrotan.cre~						~override~	LPF ADD_CRE_EFFECT INT_VAR opcode = 176 parameter1 = 2 timing = 9 target = 1 END
	COPY ~Derats_KriBinn/Divers/pxkribi1.spl~			~override~
END
COPY_EXISTING	~pxkribi0.spl~				~override/pxkribi4.spl~ WRITE_ASCII 0x13e ~pxkrib2v~ #8
